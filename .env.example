# Copy this file to .env and fill in the keys you have.
# The four example guides render with no keys.
# Live generation needs ONE model key and ONE search key.
# Restart the server after changing this file.

# --- Model (set one) ---
# Which provider to call. "auto" uses OpenAI if OPENAI_API_KEY is set,
# otherwise Anthropic. Set this only when both keys exist and you want to choose.
LLM_PROVIDER=auto

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Confirm this model is enabled on your key. The default is a guess, not a promise.
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint works. Free option, Google Gemini (key from https://aistudio.google.com/apikey):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional, for thinking models (o-series, Gemini 2.5). low is much faster.
OPENAI_REASONING_EFFORT=

# Only for networks whose DNS returns fake IPs in 198.18.0.0/15. Leave off otherwise.
ALLOW_FAKE_IP_DNS=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Confirm this model is enabled on your key.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Search (set one) ---
# "auto" uses Tavily if TAVILY_API_KEY is set, otherwise Serper.
SEARCH_PROVIDER=auto

# Tavily: https://tavily.com
TAVILY_API_KEY=

# Serper (Google results): https://serper.dev
SERPER_API_KEY=

# --- Optional read-only browser check ---
# auto: run the check only when Playwright is installed
# on:   require the check (generation continues with a note if the browser fails)
# off:  never open a browser
# Install with: pip install playwright && playwright install chromium
BROWSER_CHECK=auto

# Where generated guides are saved. Curated examples live in code and are not written here.
DATA_DIR=data

# How many documentation pages to open per live run.
MAX_PAGES=8
